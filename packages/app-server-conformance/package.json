{
  "name": "app-server-conformance",
  "private": true,
  "bin": {
    "t3-app-server-conformance": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    "./json-rpc-driver": {
      "types": "./src/protocol/JsonRpcDriver.ts",
      "import": "./src/protocol/JsonRpcDriver.ts"
    },
    "./jsonl-transport": {
      "types": "./src/protocol/JsonlTransport.ts",
      "import": "./src/protocol/JsonlTransport.ts"
    },
    "./child-process-transport": {
      "types": "./src/servers/ChildProcessJsonlTransport.ts",
      "import": "./src/servers/ChildProcessJsonlTransport.ts"
    },
    "./message-recorder": {
      "types": "./src/protocol/MessageRecorder.ts",
      "import": "./src/protocol/MessageRecorder.ts"
    },
    "./schema-validator": {
      "types": "./src/compare/SchemaValidator.ts",
      "import": "./src/compare/SchemaValidator.ts"
    },
    "./partial-order": {
      "types": "./src/compare/PartialOrder.ts",
      "import": "./src/compare/PartialOrder.ts"
    },
    "./scenario-runner": {
      "types": "./src/scenario/CoreLifecycleScenario.ts",
      "import": "./src/scenario/CoreLifecycleScenario.ts"
    },
    "./configured-harness": {
      "types": "./src/harness/ConfiguredHarness.ts",
      "import": "./src/harness/ConfiguredHarness.ts"
    },
    "./trace-normalizer": {
      "types": "./src/normalize/TraceNormalizer.ts",
      "import": "./src/normalize/TraceNormalizer.ts"
    },
    "./reference-manifest": "./reference-manifest.json"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vp test run",
    "verify-harness": "node src/bin.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "effect-codex-app-server": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
