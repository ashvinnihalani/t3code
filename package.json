{
  "name": "@t3-codex/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "dev": "node scripts/dev-desktop.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vp run --filter './apps/*' --filter './packages/*' build",
    "build:desktop": "vp run --filter @t3-codex/desktop --filter @t3-codex/web build",
    "dist:mac": "vp run build:desktop && vp run --filter @t3-codex/desktop dist:mac",
    "start": "vp run build:desktop && vp run --filter @t3-codex/desktop start",
    "start:desktop": "vp run --filter @t3-codex/desktop start",
    "typecheck": "vp run --filter './apps/*' --filter './packages/*' typecheck",
    "test": "vp run --filter './apps/*' --filter './packages/*' test",
    "test:desktop-smoke": "vp run --filter @t3-codex/desktop smoke-test",
    "harness:verify": "vp run --filter app-server-conformance verify-harness",
    "protocol:generate": "vp run --filter effect-codex-app-server generate",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
